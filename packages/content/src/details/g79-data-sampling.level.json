  "feedback": {
    "sampling-no-sample": {
      "messageKey": "还没有样本。",
      "hintKey": "先抽一批，至少两批 40 个。",
      "focus": "sample"
    },
    "sampling-too-small": {
      "messageKey": "样本太少，比例还不稳。",
      "hintKey": "再抽一批，累计到 40 个以上。",
      "focus": "n"
    },
    "sampling-no-claim": {
      "messageKey": "还差一句用样本比例与区间写出的结论。",
      "hintKey": "看看样本比例和区间，再记录结论。",
      "focus": "claim"
    },
    "sampling-claim-mismatch": {
      "messageKey": "结论和样本对不上。",
      "hintKey": "结论里的比例和 n 要从样本里来。",
      "focus": "claim"
    },
    "sampling-too-few-batches": {
      "messageKey": "只抽了一批，看不出波动。",
      "hintKey": "至少抽两批，比较两次样本比例。",
      "focus": "batches"
    },
    "sampling-far": {
      "messageKey": "样本比例离总体太远，结论不可信。",
      "hintKey": "多抽几批，或看看是不是抽样方式有偏。",
      "focus": "value"
    },
    "sampling-ci-miss": {
      "messageKey": "区间没有盖住真实比例。",
      "hintKey": "样本量小时区间会宽，但不应漏掉真值。",
      "focus": "ci"
    }
  },
