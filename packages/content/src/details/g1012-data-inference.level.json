    "inference-no-sample": {
      "messageKey": "还没有两组样本。",
      "hintKey": "先看两组比例和区间。",
      "focus": "stats"
    },
    "inference-too-small": {
      "messageKey": "样本量太小，区间太宽。",
      "hintKey": "每组至少 30 个样本。",
      "focus": "n"
    },
    "inference-sample-mismatch": {
      "messageKey": "报告里的样本量和题目对不上。",
      "hintKey": "使用题目给的两组 50 个样本。",
      "focus": "n"
    },
    "inference-no-claim": {
      "messageKey": "还差一句差值结论。",
      "hintKey": "写下差值、区间与样本量。",
      "focus": "claim"
    },
    "inference-claim-wrong": {
      "messageKey": "结论方向和区间不一致。",
      "hintKey": "区间整体在 0 上方，才说明 A 更高。",
      "focus": "direction"
    },
    "inference-ci-includes-zero": {
      "messageKey": "区间包含 0，差异还不明确。",
      "hintKey": "区间跨过 0 时不能下“某组更高”的结论。",
      "focus": "ci"
    }
