  "feedback": {
    "argue-claim-unsupported": {
      "messageKey": "这个棋盘确实铺不满；主张选错了。",
      "hintKey": "先试几块，看看最后总会剩下什么。",
      "focus": "claim"
    },
    "argue-warrant-unsupported": {
      "messageKey": "这条依据在这一关还检验不了。",
      "hintKey": "换一条能由黑白格或总格数验证的依据。",
      "focus": "warrant"
    },
    "argue-invariant-false": {
      "messageKey": "证据和图形对不上，或这个量不能排除铺满。",
      "hintKey": "换一条能由黑白格或总格数验证的依据。",
      "focus": "evidence"
    },
    "argue-evidence-missing": {
      "messageKey": "论证还缺一块：主张、依据、证据或范围。",
      "hintKey": "先统计，再把数据挂到论证上。",
      "focus": "argument"
    },
    "argue-scope-wrong": {
      "messageKey": "适用范围写错了。",
      "hintKey": "这是 1×2 多米诺铺满。",
      "focus": "scope"
    },
